{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "xingyu-xingyuan",
	"compatibility_date": "2026-08-14",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "xingyu-xingyuan"
		}
	],
	"images": {
		// Enable image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	},
	// D1 database for user/account data
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "xingyu-xingyuan-db",
			"database_id": "15599b1a-e849-4be0-9659-e0d9c0b48674"
		}
	],
	"vars": {
		"AUTH_FROM_EMAIL": "Stella@mail.ranran.org.cn",
		"STAR_MAIL_FROM_EMAIL": "Stella · 星邮 <stella@mail.ranran.org.cn>"
	}
}